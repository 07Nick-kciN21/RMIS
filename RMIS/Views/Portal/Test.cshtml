@model RMIS.Models.Portal.LoginView

@{
    ViewData["Title"] = "桃園市工務局道路專案整合平台";
    Layout = "~/Views/Shared/_TestPortalLayout.cshtml";
}

<div class="h-100 d-flex">
    <div class="container-fluid login mainshadow">
        <div class="container">
            <div class="row justify-content-center">
                <div class="logo"
                     style="background-image: url(/img/logo.png);
                                width: 100px;
                                height: 100px;
                                background-size: contain;
                                background-repeat: no-repeat;
                                background-position: center;">
                </div>
                <h4 class="text-center system_name fw-bold">桃園市工務局道路專案整合平台</h4>

                <div class="col-md-8">
                    <!-- 狀態顯示 -->
                    <div id="statusArea" class="mb-3">
                        <div class="alert alert-info">
                            <small>請確認已插入自然人憑證並連接讀卡機</small>
                        </div>
                    </div>

                    <!-- 登入按鈕 -->
                    <div class="form-group row d-flex justify-content-center mb-3">
                        <button type="button"
                                class="btn w-100 text-white br25 fs-5 mainshadow fw-bold"
                                style="background-color:#B7A591"
                                onclick="loginWithCertificate()">
                            憑證登入
                        </button>
                    </div>

                    <!-- 憑證資訊顯示 -->
                    <div id="certInfoDisplay" class="card mt-3" style="display:none;">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">憑證資訊</h6>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm mb-0">
                                <tr>
                                    <th>姓名：</th>
                                    <td><span id="userName"></span></td>
                                </tr>
                                <tr>
                                    <th>卡號：</th>
                                    <td><span id="validity"></span></td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- 除錯日誌 -->
                    <div class="card mt-3">
                        <div class="card-header bg-light">
                            <small class="text-muted">執行日誌</small>
                            <button class="btn btn-sm btn-outline-secondary float-end" onclick="clearLog()">清除</button>
                        </div>
                        <div class="card-body" style="max-height: 250px; overflow-y: auto;">
                            <div id="logArea" style="font-family: monospace; font-size: 11px;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function addLog(message, type = 'info') {
        const logArea = document.getElementById('logArea');
        const time = new Date().toLocaleTimeString('zh-TW', { hour12: false });
        const colors = {
            info: '#0d6efd',
            success: '#198754',
            error: '#dc3545',
            warning: '#ffc107'
        };

        const logEntry = document.createElement('div');
        logEntry.style.color = colors[type] || colors.info;
        logEntry.style.marginBottom = '3px';
        logEntry.textContent = `[${time}] ${message}`;

        logArea.appendChild(logEntry);
        logArea.scrollTop = logArea.scrollHeight;
        console.log(`[${time}] ${message}`);
    }

    function clearLog() {
        document.getElementById('logArea').innerHTML = '';
    }

    function updateStatus(message, type = 'info') {
        const statusArea = document.getElementById('statusArea');
        const alertClass = {
            info: 'alert-info',
            success: 'alert-success',
            error: 'alert-danger',
            warning: 'alert-warning'
        };

        statusArea.innerHTML = `
                <div class="alert ${alertClass[type] || 'alert-info'}">
                    <small>${message}</small>
                </div>
            `;
    }

    // 使用後端代理方式登入（解決 Mixed Content 問題）
    async function loginWithCertificate() {
        addLog('========== 開始憑證登入（後端代理）==========', 'info');
        updateStatus('正在讀取憑證...', 'info');

        try {
            addLog('向後端請求讀取憑證...', 'info');

            // 直接呼叫後端，後端會去呼叫 HiCOS API
            const response = await fetch('/Portal/GetCertificateFromHiCOS', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            addLog('後端回應狀態: HTTP ' + response.status, 'info');

            // 解析回應
            const result = await response.json();

            if (response.ok && result.success) {
                addLog('✓ 憑證驗證成功', 'success');
                addLog('使用者: ' + result.userName, 'success');

                // 顯示憑證資訊
                if (result.certInfo) {
                    document.getElementById('userName').textContent = result.userName || '未知';
                    document.getElementById('validity').textContent = result.certInfo.serialNumber || '未知';
                    document.getElementById('certInfoDisplay').style.display = 'block';

                    addLog('身分證字號: ' + result.certInfo.idNumber, 'info');
                }

                addLog('✓✓✓ 登入成功！', 'success');
                updateStatus('登入成功！正在導向...', 'success');

                // 導向首頁
                // setTimeout(() => {
                //     window.location.href = "/Home/Index";
                // }, 1500);

            } else {
                // 處理錯誤
                const errorMsg = result.error || result.message || '登入失敗';
                addLog('✗ ' + errorMsg, 'error');

                if (result.detail) {
                    addLog('詳細資訊: ' + result.detail, 'error');
                }

                updateStatus('登入失敗', 'error');

                // 根據不同錯誤給予不同提示
                let userMessage = errorMsg;

                if (errorMsg.includes('無法連接 HiCOS')) {
                    userMessage = '無法連接 HiCOS 服務\n\n請確認：\n1. HiCOS 卡片管理工具已安裝\n2. HiCOS 服務正在執行\n3. 在工作管理員中可以看到 HiCOS 相關程序';
                } else if (errorMsg.includes('找不到憑證')) {
                    userMessage = '找不到憑證\n\n請確認：\n1. 自然人憑證已插入\n2. 讀卡機已連接且正常\n3. 開啟 HiCOS 卡片管理工具可以讀取憑證';
                } else if (errorMsg.includes('尚未註冊')) {
                    userMessage = '此憑證尚未註冊\n\n身分證字號：' + (result.idNumber || '未知') + '\n\n請先使用一般方式註冊帳號';
                }

                alert(userMessage);
            }

        } catch (error) {
            addLog('✗ 請求錯誤: ' + error.message, 'error');
            updateStatus('連線失敗', 'error');

            let errorMsg = '連線失敗：' + error.message;

            if (error.message.includes('Failed to fetch') || error.message.includes('NetworkError')) {
                errorMsg = '網路連線失敗\n\n請確認：\n1. 網路連線正常\n2. 後端服務正在執行\n3. Session 未過期';
            }

            alert(errorMsg);
        }
    }

    // 頁面載入時顯示提示
    window.addEventListener('load', () => {
        addLog('頁面已載入', 'info');
        addLog('使用後端代理方式讀取憑證', 'info');
        addLog('優點：解決 HTTPS/HTTP Mixed Content 問題', 'info');
        addLog('', 'info');
        addLog('請確認：', 'info');
        addLog('1. HiCOS 服務正在執行', 'info');
        addLog('2. 自然人憑證已插入', 'info');
        addLog('3. 讀卡機已連接', 'info');
        addLog('', 'info');
        updateStatus('準備就緒，請點擊按鈕登入', 'info');
    });
</script>

<style>
    #logArea:empty::before {
        content: '尚無日誌...';
        color: #999;
    }
</style>
