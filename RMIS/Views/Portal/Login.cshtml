@model RMIS.Models.Portal.LoginView

@{
    ViewData["Title"] = "桃園市工務局道路專案整合平台";
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
}

<div class="h-100 d-flex">
    <div class="container-fluid login mainshadow">
        <div class="container">
            <div class="row justify-content-center">
                <div class="logo"
                        style="background-image: url(/img/logo.png);
                                width: 100px;
                                height: 100px;
                                background-size: contain;
                                background-repeat: no-repeat;
                                background-position: center;">
                </div>
                <h4 class="text-center system_name fw-bold">桃園市工務局道路專案整合平台</h2>
                    <div class="col-md-8">
                        <form action="/Portal/Login" method="post">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger text-center small mb-2" })
                            <div class="form-group row d-flex justify-content-center" style="margin-bottom: 20px">
                                <div class="col-sm-8 col-md-12 usericon">
                                    <input class="form-control br25 w-100" placeholder="&emsp;&nbsp;帳號" type="text"
                                        data-val="true" data-val-required="&#x8ACB;&#x8F38;&#x5165;&#x5E33;&#x865F;"
                                        id="UserName" name="UserName" value="" />
                                </div>
                                <span class="text-danger field-validation-valid" data-valmsg-for="UserName"
                                    data-valmsg-replace="true"></span>
                            </div>
                            <div class="form-group row d-flex justify-content-center" style="margin-bottom: 20px">
                                <div class="col-sm-8 col-md-12 pwdicon">
                                    <div class="pwd-wrapper">
                                        <input type="password" class="form-control br25 w-100"
                                            placeholder="&emsp;&nbsp;密碼" data-val="true"
                                            data-val-required="&#x8ACB;&#x8F38;&#x5165;&#x5BC6;&#x78BC;" id="Password"
                                            name="Password" autocomplete="off" />
                                        <button type="button" class="pwd-toggle" aria-label="顯示密碼" title="顯示密碼">
                                            <svg class="icon-eye" viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
                                                <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                                <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                                            </svg>
                                            <svg class="icon-eye-slash" viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
                                                <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z"/>
                                                <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z"/>
                                                <path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12-.708.708z"/>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                                <span class="text-danger field-validation-valid" data-valmsg-for="Password"
                                    data-valmsg-replace="true"></span>
                            </div>
                            <div class="form-group row d-flex justify-content-center" style="margin-bottom: 20px">
                                <div class="col-sm-12">
                                    <div class="input-group">
                                        <input id="loginCaptcha" type="text" name="loginCaptcha" class="form-control" placeholder="輸入驗證碼" required>
                                        <span class="input-group-text p-0" style="background: transparent; border:none;">
                                            <img class="captchaImage"
                                                    data-type="login"
                                                    alt="驗證碼"
                                                    title="點擊更新驗證碼"
                                                    style="cursor:pointer; border:1px solid #ccc; height:40px;" />
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-4 mt-2 text-end w-100">
                                <a id="forgetBtn" data-bs-toggle="modal" data-bs-target="#forgetModal"
                                    class="txtltbrown fw-bold">忘記密碼</a>
                            </div>
                            <div class="form-group row d-flex justify-content-center" style="margin-bottom: 20px">
                                <button type="submit" class="btn w-100 text-white br25 fs-5 mainshadow fw-bold"
                                    style="background-color:#B7A591">登入</button>
                            </div>                            
                        </form>
                        <form action="/Portal/LoginUseCertificate" method="post">
                            <div class="form-group row d-flex justify-content-center" style="margin-bottom: 20px">
                                <button id="certificateLoginBtn" type="button" class="btn w-100 text-white br25 fs-5 mainshadow fw-bold"
                                        style="background-color:#B7A591">
                                    自然人憑證登入
                                </button>
                            </div>
                        </form>
                        <div class="row justify-content-center">
                            <div class="col-sm-4 col-md-12 mt-2 text-center">
                                <a id="registerBtn" data-bs-toggle="modal" data-bs-target="#registerModal"
                                    class="txtltbrown fw-bold">申請帳號</a>
                            </div>
                        </div>
                        <pre id="output"></pre>
                    </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="registerModal" tabindex="-1" aria-labelledby="registerModalLabel">
    <div class="modal-dialog modal-lg modal-dialog-centered ">
        <div class="modal-content register-modal">
            <form id="registerForm" class="needs-validation" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="registerModalLabel">申請帳號</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group row mb-3">
                        <label for="registerDisplayName" class="col-sm-3 col-form-label">使用者名稱</label>
                        <div class="col-sm-9">
                            <input id="registerDisplayName" class="form-control" type="text" name="DisplayName"
                                required pattern="^[\u4e00-\u9fa5a-zA-Z0-9_]{2,20}$">
                            <div class="invalid-feedback">
                                使用者名稱需為 2~20 字，僅限中英文、數字與底線。
                            </div>
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label for="registerAccount" class="col-sm-3 col-form-label">帳號</label>
                        <div class="col-sm-9">
                            <input id="registerAccount" class="form-control" type="text" name="Account" required
                                pattern="^[a-zA-Z0-9]{8,20}$">
                            <div class="invalid-feedback">
                                帳號需為 8~20 字英文或數字。
                            </div>
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label for="registerPassword" class="col-sm-3 col-form-label">密碼</label>
                        <div class="col-sm-9">
                            <div class="pwd-wrapper">
                                <input id="registerPassword" class="form-control" type="password" name="Password"
                                    autocomplete="off" required pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,20}$">
                                <button type="button" class="pwd-toggle" aria-label="顯示密碼" title="顯示密碼">
                                    <svg class="icon-eye" viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
                                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                                    </svg>
                                    <svg class="icon-eye-slash" viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
                                        <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z"/>
                                        <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z"/>
                                        <path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12-.708.708z"/>
                                    </svg>
                                </button>
                                <div id="passwordFeedback" class="invalid-feedback">
                                    密碼需包含大小寫英文字母與數字，長度 8~20。
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label for="registerConfirmPassword" class="col-sm-3 col-form-label">確認密碼</label>
                        <div class="col-sm-9">
                            <div class="pwd-wrapper">
                                <input id="registerConfirmPassword" class="form-control" type="password"
                                    name="ConfirmPassword" autocomplete="off" required>
                                <button type="button" class="pwd-toggle" aria-label="顯示密碼" title="顯示密碼">
                                    <svg class="icon-eye" viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
                                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                                    </svg>
                                    <svg class="icon-eye-slash" viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
                                        <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z"/>
                                        <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z"/>
                                        <path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12-.708.708z"/>
                                    </svg>
                                </button>
                                <div id="confirmPasswordFeedback" class="invalid-feedback">
                                    請再次輸入密碼。
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label for="DepartmentId" class="col-sm-3 col-form-label">部門</label>
                        <div class="col-sm-9">
                            <select id="DepartmentId" class="form-control" name="DepartmentId" required>
                                <option value="" disabled selected>請選擇部門</option>
                            </select>
                            <div class="invalid-feedback">
                                請選擇部門。
                            </div>
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label for="RoleId" class="col-sm-3 col-form-label">身分</label>
                        <div class="col-sm-9">
                            <select id="RoleId" class="form-control" name="RoleId" required>
                                <option value="" selected disabled>請選擇身分</option>
                            </select>
                            <div class="invalid-feedback">
                                請選擇身分。
                            </div>
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label for="Email" class="col-sm-3 col-form-label">信箱</label>
                        <div class="col-sm-9">
                            <input id="Email" class="form-control" name="Email" type="email" required>
                            <div class="invalid-feedback">
                                請輸入有效的信箱地址。
                            </div>
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label for="Phone" class="col-sm-3 col-form-label">手機</label>
                        <div class="col-sm-9">
                            <input id="Phone" class="form-control" type="tel" name="Phone" placeholder="09xxxxxxxx"
                                pattern="^09\d{8}$" required>
                            <div class="invalid-feedback">
                                請輸入有效的台灣手機號碼（09xxxxxxxx）。
                            </div>
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label class="col-sm-3 col-form-label">驗證碼</label>
                        <div class="col-sm-9">
                            <div class="input-group">
                                <input id="registerCaptcha" type="text" name="registerCaptcha"
                                       class="form-control" placeholder="輸入驗證碼" required>
                                <span class="input-group-text p-0" style="background:transparent;border:none;">
                                    <img class="captchaImage" data-type="register"
                                         alt="驗證碼" title="點擊更新驗證碼"
                                         style="cursor:pointer;border:1px solid #ccc;height:40px;" />
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">送出</button>
                </div>            
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="forgetModal" tabindex="-1" aria-labelledby="forgetModalLabel">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content register-modal">
            <form id="forgetForm" class="needs-validation" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="forgetModalLabel">忘記密碼</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group row mb-3">
                        <label for="forgetAccount" class="col-sm-3 col-form-label">帳號</label>
                        <div class="col-sm-9">
                            <input id="forgetAccount" class="form-control" type="text" name="account" required>
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label for="forgetEmail" class="col-sm-3 col-form-label">信箱</label>
                        <div class="col-sm-9">
                            <input id="forgetEmail" class="form-control" type="email" name="email"
                                   pattern="^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$" required>
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label class="col-sm-3 col-form-label">驗證碼</label>
                        <div class="col-sm-9">
                            <div class="input-group">
                                <input id="forgetCaptcha" type="text" name="forgetCaptcha"
                                       class="form-control" placeholder="輸入驗證碼" required>
                                <span class="input-group-text p-0" style="background:transparent;border:none;">
                                    <img class="captchaImage" data-type="forget"
                                         alt="驗證碼" title="點擊更新驗證碼"
                                         style="cursor:pointer;border:1px solid #ccc;height:40px;" />
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">提交申請</button>
                </div>
            </form>
        </div>
    </div>
</div>
