<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/_layout.css" />
    <link rel="stylesheet" href="~/css/loading.css" />
    <link rel="stylesheet" href="~/css/new/index/z-layers.css" />
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="~/lib//leaflet-geoman/leaflet-geoman.css" />

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/leaflet/leaflet.js"></script>

    <script src="~/lib/leaflet-geoman/leaflet-geoman.min.js"></script>

    <!-- ✅ JavaScript 放在底部依序 -->
    <script src="~/lib/select2/select2.min.js"></script>
    <script src="~/lib/pikaday/pikaday.js"></script>
    <script src="~/lib/jQuery-QueryBuilder/query-builder.standalone.min.js"></script>
    <script src="~/lib/leaflet-draw/leaflet.draw.js"></script>
    <script src="~/lib/xlsx/xlsx.full.min.js"></script>
    <script src="~/lib/leaflet-polylinedecorator/leaflet-polylinedecorator.js"></script>
    <script src="~/lib/leaflet-markercluster/leaflet.markercluster.js"></script>
    <script src="~/lib/togeojson/togeojson.js"></script>
    <script src="~/lib/leaflet-omnivore/leaflet-omnivore.min.js"></script>
    <script src="~/lib/leaflet-gridlayer-googlemutant/Leaflet.GoogleMutant.js"></script>
    <script src="~/lib/leaflet-pip/leaflet-pip.min.js"></script>
    <script src="~/lib/leaflet-geometryutil/leaflet.geometryutil.min.js"></script>
    <script src="~/lib/leaflet-editable/Leaflet.Editable.js"></script>
    <script src="https://unpkg.com/leaflet.vectorgrid@1.3.0/dist/Leaflet.VectorGrid.bundled.min.js"></script>
    <script src="~/lib/proj4/proj4.js"></script>
    <script src="~/lib/turf/turf.js"></script>
    <script src="~/js/sessionManager.js"></script>

    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        .content-wrapper {
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        /* z-index 層級統一由 z-layers.css 管理 */
    </style>
</head>
<body>
    <div id="loadingOverlay" class="loading-overlay hidden">
        <div class="spinner"></div>
        <span class="loading-text">載入中...</span>
    </div>

    <div class="content-wrapper">
        @RenderBody()

    </div>
    @await RenderSectionAsync("Scripts", required: false)
    <div class="modal fade modal-session" id="extendSessionModal" tabindex="-1" aria-labelledby="extendSessionModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="extendSessionModalLabel">登入即將過期</h5>
                </div>
                <div class="modal-body">
                    您的登入即將到期，是否延長？
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="logoutBtn">登出</button>
                    <button type="button" class="btn btn-primary" id="extendBtn">延長登入</button>
                </div>
            </div>
        </div>
    </div>
</body>
<script>
    $(document).ready(function () {
        $('#extendSessionModal').on('show.bs.modal', function () {
            setTimeout(function () {
                $('.modal-backdrop').last().addClass('modal-session-backdrop');
            }, 0);
        }).on('hidden.bs.modal', function () {
            $('.modal-session-backdrop').removeClass('modal-session-backdrop');
        });
    });
</script>
</html>
