@model RMIS.Models.Account.Users.UpdateUserView;

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
    <head>
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/lib/jquery/dist/jquery.js"></script>
        <script src="~/js/account/user/updateUser.js"></script>
    </head>
    <body>
        <div class="modal-content">
            <div class="modal-body">
                <form id="updateUserForm" class="needs-validation" novalidate>
                    <input type="hidden" asp-for="UserId">

                    <div class="form-group row mb-3">
                        <label asp-for="DisplayName" class="col-sm-2 col-form-label">名稱</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" asp-for="DisplayName">
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label asp-for="UserName" class="col-sm-2 col-form-label">帳號</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" asp-for="UserName" readonly>
                        </div>
                    </div>
                    <!-- 變更密碼 -->
                    <div class="form-group row mb-2">
                        <label class="col-sm-2 col-form-label">密碼</label>
                        <div class="col-sm-10">
                            <button type="button" class="btn btn-outline-primary btn-sm"
                                    data-bs-toggle="collapse" data-bs-target="#resetPasswordSection">
                                變更密碼
                            </button>
                        </div>
                    </div>
                    <div class="collapse mb-3" id="resetPasswordSection">
                        <div class="card card-body">
                            <form id="resetPasswordForm" class="needs-validation" novalidate>
                                <input type="hidden" asp-for="UserId">
                                <div class="form-group row mb-2">
                                    <label class="col-sm-3 col-form-label">新密碼</label>
                                    <div class="col-sm-9">
                                        <input type="password" id="NewPassword" name="NewPassword" class="form-control"
                                               pattern="^(?=.*[A-Za-z])(?=.*\d).{6,20}$" required>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-sm-3 col-form-label">確認新密碼</label>
                                    <div class="col-sm-9">
                                        <input type="password" id="CheckPassword" name="CheckPassword" class="form-control" required>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-sm-3 col-form-label">驗證碼</label>
                                    <div class="col-sm-9">
                                        <div class="input-group">
                                            <input id="adminUpdate_newPasswordCaptcha" type="text"
                                                   name="adminUpdate_newPasswordCaptcha" class="form-control"
                                                   placeholder="輸入驗證碼" required>
                                            <span class="input-group-text p-0" style="background:transparent;border:none;">
                                                <img class="captchaImage" data-type="adminUpdate_newPassword"
                                                     alt="驗證碼" title="點擊更新驗證碼"
                                                     style="cursor:pointer;border:1px solid #ccc;height:40px;" />
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <p class="text-danger small mb-2">密碼規格：6字元以上、包含英文字母與數字且不可與帳號相同。</p>
                                <button type="submit" class="btn btn-primary btn-sm">儲存</button>
                            </form>
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label asp-for="RoleId" class="col-sm-2 col-form-label">身分</label>
                        <div class="col-sm-10">
                            @Html.DropDownListFor(model => model.RoleId, Model.Roles, new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label asp-for="DepartmentId" class="col-sm-2 col-form-label">部門</label>
                        <div class="col-sm-10">
                            @Html.DropDownListFor(model => model.DepartmentId, Model.Departments, new { @class = "form-control" })
                        </div>
                    </div>

                    <!-- 變更信箱 -->
                    <div class="form-group row mb-2">
                        <label asp-for="Email" class="col-sm-2 col-form-label">信箱</label>
                        <div class="col-sm-10">
                            <button type="button" class="btn btn-outline-primary btn-sm"
                                    data-bs-toggle="collapse" data-bs-target="#resetEmailSection">
                                變更信箱
                            </button>
                        </div>
                    </div>
                    <div class="collapse mb-3" id="resetEmailSection">
                        <div class="card card-body">
                            <form id="resetEmailForm" class="needs-validation" novalidate>
                                <input type="hidden" asp-for="UserId">
                                <div class="form-group row mb-2">
                                    <label class="col-sm-3 col-form-label">新信箱</label>
                                    <div class="col-sm-9">
                                        <input type="email" id="newEmail" name="newEmail" class="form-control"
                                               placeholder="新信箱"
                                               pattern="^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$" required>
                                        <div class="invalid-feedback">請輸入有效的信箱地址</div>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-sm-3 col-form-label">驗證碼</label>
                                    <div class="col-sm-9">
                                        <div class="input-group">
                                            <input id="adminUpdate_newEmailCaptcha" type="text"
                                                   name="adminUpdate_newEmailCaptcha" class="form-control" required>
                                            <span class="input-group-text p-0" style="background:transparent;border:none;">
                                                <img class="captchaImage" data-type="newEmail"
                                                     alt="驗證碼" title="點擊更新驗證碼"
                                                     style="cursor:pointer;border:1px solid #ccc;height:40px;" />
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm">送出驗證碼</button>
                            </form>
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label asp-for="Phone" class="col-sm-2 col-form-label">電話</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" asp-for="Phone">
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-sm-2 col-form-label">狀態</label>
                        <div class="col-sm-10 d-flex align-items-center">
                            <div class="form-check me-3">
                                <input type="radio" class="form-check-input" asp-for="Status" value="true" id="statusEnabled">
                                <label class="form-check-label" for="statusEnabled">啟用</label>
                            </div>
                            <div class="form-check">
                                <input type="radio" class="form-check-input" asp-for="Status" value="false" id="statusDisabled">
                                <label class="form-check-label" for="statusDisabled">禁止</label>
                            </div>
                        </div>
                    </div>                    
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                <button type="submit" form="updateUserForm" class="btn btn-primary">儲存變更</button>
            </div>
        </div>

        <div id="globalModalOverlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(255,255,255,0.7); z-index:2000; justify-content:center; align-items:center;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">載入中...</span>
            </div>
        </div>
    </body>
</html>
