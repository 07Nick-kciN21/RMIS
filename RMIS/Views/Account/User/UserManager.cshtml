@{
    ViewData["Title"] = "使用者管理";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<link rel="stylesheet" href="~/css/Account/userManager.css" />
<script type="module" src="~/js/account/user/userManager.js"></script>

<div class="user-page">
    <h2>使用者列表</h2>
    <div style="display: flex;">
        <select id="departmentSelector" class="selector form-select">
        </select>
        <button id ="createUser">新增使用者</button>
    </div>
    <div class="table-container">
        <table class="table table-bordered text-center permissionTable">
            <thead>
                <tr>
                    <th class="department-cell">部門</th>
                    <th class="display-cell">使用者</th>
                    <th class="user-cell">帳號</th>
                    <th class="role-cell">身分</th>
                    <th class="status-cell">狀態</th>
                    <th class="status-cell">信箱認證</th>
                    <th class="action-cell">操作</th>
                </tr>
            </thead>
        </table>
        <!-- tbody 放在獨立容器中滾動 -->
        <div class="tbody-scroll">
            <table class="table table-bordered text-center permissionTable mb-0">
                <tbody id="userTable">
                    <!-- 資料動態插入 -->
                </tbody>
            </table>
        </div>
    </div>

    <div id="userPage" class="d-flex justify-content-center mt-2">
    </div>
</div>

<!-- 編輯使用者 Modal -->
<div class="modal fade" id="updateUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">修改使用者資料</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="updateUserForm" class="needs-validation" novalidate>
                    <input type="hidden" id="edit-UserId" name="UserId">

                    <div class="form-group row mb-3">
                        <label class="col-sm-2 col-form-label">名稱</label>
                        <div class="col-sm-10">
                            <input type="text" id="edit-DisplayName" name="DisplayName" class="form-control">
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-sm-2 col-form-label">帳號</label>
                        <div class="col-sm-10">
                            <input type="text" id="edit-UserName" name="UserName" class="form-control" readonly>
                        </div>
                    </div>

                    <div class="form-group row mb-2">
                        <label class="col-sm-2 col-form-label">密碼</label>
                        <div class="col-sm-10">
                            <button type="button" class="btn btn-outline-primary btn-sm"
                                    data-bs-toggle="collapse" data-bs-target="#resetPasswordSection">
                                變更密碼
                            </button>
                        </div>
                    </div>
                    <div class="collapse mb-3" id="resetPasswordSection">
                        <div class="card card-body">
                            <div id="resetPasswordForm">
                                <input type="hidden" id="edit-pwd-UserId">
                                <div class="form-group row mb-2">
                                    <label class="col-sm-3 col-form-label">新密碼</label>
                                    <div class="col-sm-9">
                                        <input type="password" id="NewPassword" class="form-control"
                                               pattern="^(?=.*[A-Za-z])(?=.*\d).{6,20}$" required>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-sm-3 col-form-label">確認新密碼</label>
                                    <div class="col-sm-9">
                                        <input type="password" id="CheckPassword" class="form-control" required>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-sm-3 col-form-label">驗證碼</label>
                                    <div class="col-sm-9">
                                        <div class="input-group">
                                            <input id="adminUpdate_newPasswordCaptcha" type="text"
                                                   class="form-control" placeholder="輸入驗證碼" required>
                                            <span class="input-group-text p-0" style="background:transparent;border:none;">
                                                <img class="captchaImage" data-type="adminUpdate_newPassword"
                                                     alt="驗證碼" title="點擊更新驗證碼"
                                                     style="cursor:pointer;border:1px solid #ccc;height:40px;" />
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <p class="text-danger small mb-2">密碼規格：6字元以上、包含英文字母與數字且不可與帳號相同。</p>
                                <button type="button" id="btn-pwd-submit" class="btn btn-primary btn-sm">儲存</button>
                            </div>
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-sm-2 col-form-label">身分</label>
                        <div class="col-sm-10">
                            <select id="edit-RoleId" name="RoleId" class="form-control"></select>
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-sm-2 col-form-label">部門</label>
                        <div class="col-sm-10">
                            <select id="edit-DepartmentId" name="DepartmentId" class="form-control"></select>
                        </div>
                    </div>

                    <div class="form-group row mb-2">
                        <label class="col-sm-2 col-form-label">信箱</label>
                        <div class="col-sm-10">
                            <button type="button" class="btn btn-outline-primary btn-sm"
                                    data-bs-toggle="collapse" data-bs-target="#resetEmailSection">
                                變更信箱
                            </button>
                        </div>
                    </div>
                    <div class="collapse mb-3" id="resetEmailSection">
                        <div class="card card-body">
                            <div id="resetEmailForm">
                                <input type="hidden" id="edit-email-UserId">
                                <div class="form-group row mb-2">
                                    <label class="col-sm-3 col-form-label">新信箱</label>
                                    <div class="col-sm-9">
                                        <input type="email" id="newEmail" class="form-control"
                                               placeholder="新信箱"
                                               pattern="^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$" required>
                                        <div class="invalid-feedback">請輸入有效的信箱地址</div>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-sm-3 col-form-label">驗證碼</label>
                                    <div class="col-sm-9">
                                        <div class="input-group">
                                            <input id="adminUpdate_newEmailCaptcha" type="text"
                                                   class="form-control" required>
                                            <span class="input-group-text p-0" style="background:transparent;border:none;">
                                                <img class="captchaImage" data-type="newEmail"
                                                     alt="驗證碼" title="點擊更新驗證碼"
                                                     style="cursor:pointer;border:1px solid #ccc;height:40px;" />
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <button type="button" id="btn-email-submit" class="btn btn-primary btn-sm">送出驗證碼</button>
                            </div>
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-sm-2 col-form-label">電話</label>
                        <div class="col-sm-10">
                            <input type="text" id="edit-Phone" name="Phone" class="form-control">
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-sm-2 col-form-label">狀態</label>
                        <div class="col-sm-10 d-flex align-items-center">
                            <div class="form-check me-3">
                                <input type="radio" class="form-check-input" name="Status" value="true" id="statusEnabled">
                                <label class="form-check-label" for="statusEnabled">啟用</label>
                            </div>
                            <div class="form-check">
                                <input type="radio" class="form-check-input" name="Status" value="false" id="statusDisabled">
                                <label class="form-check-label" for="statusDisabled">禁止</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                <button type="submit" form="updateUserForm" class="btn btn-primary">儲存變更</button>
            </div>
        </div>
    </div>
</div>

<!-- 新增使用者 Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">新增使用者</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createUserForm" class="needs-validation" novalidate>

                    <div class="form-group row mb-3">
                        <label class="col-sm-2 col-form-label">使用者名稱</label>
                        <div class="col-sm-10">
                            <input type="text" id="create-DisplayName" name="DisplayName" class="form-control" required>
                            <div class="invalid-feedback">使用者名稱需為 2~20 字，僅限中英文、數字與底線。</div>
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-sm-2 col-form-label">帳號</label>
                        <div class="col-sm-10">
                            <input type="text" id="create-Account" name="Account" class="form-control"
                                   required pattern="^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d]{6,20}$">
                            <div class="invalid-feedback">帳號需為 6~20 字，且包含英文字母與數字</div>
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-sm-2 col-form-label">密碼</label>
                        <div class="col-sm-10">
                            <input type="password" id="create-Password" name="Password" class="form-control"
                                   required pattern="^(?=.*[A-Za-z])(?=.*\d).{6,20}$">
                            <div class="invalid-feedback" id="create-passwordFeedback">密碼需為 6~20 位，且包含英文字母與數字</div>
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-sm-2 col-form-label">身分</label>
                        <div class="col-sm-10">
                            <select id="create-RoleId" name="RoleId" class="form-control" required></select>
                            <div class="invalid-feedback">請選擇身分</div>
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-sm-2 col-form-label">部門</label>
                        <div class="col-sm-10">
                            <select id="create-DepartmentId" name="DepartmentId" class="form-control" required></select>
                            <div class="invalid-feedback">請選擇部門</div>
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-sm-2 col-form-label">信箱</label>
                        <div class="col-sm-10">
                            <input type="email" id="create-Email" name="Email" class="form-control"
                                   required pattern="^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$">
                            <div class="invalid-feedback">請輸入有效的信箱地址</div>
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-sm-2 col-form-label">電話</label>
                        <div class="col-sm-10">
                            <input type="text" id="create-Phone" name="Phone" class="form-control"
                                   required pattern="^09\d{8}$">
                            <div class="invalid-feedback">請輸入有效的台灣手機號碼（09xxxxxxxx）</div>
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-sm-2 col-form-label">狀態</label>
                        <div class="col-sm-10 d-flex align-items-center">
                            <div class="form-check me-3">
                                <input type="radio" class="form-check-input" name="create-Status" value="true" id="create-statusEnabled" checked>
                                <label class="form-check-label" for="create-statusEnabled">啟用</label>
                            </div>
                            <div class="form-check">
                                <input type="radio" class="form-check-input" name="create-Status" value="false" id="create-statusDisabled">
                                <label class="form-check-label" for="create-statusDisabled">禁止</label>
                            </div>
                        </div>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                <button type="submit" form="createUserForm" class="btn btn-primary">儲存</button>
            </div>
        </div>
    </div>
</div>
