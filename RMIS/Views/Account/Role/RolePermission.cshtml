@model RMIS.Models.Account.Roles.ReadRolePermission
@using System.Linq

@{
    ViewData["Title"] = "功能群組權限管理";
    Layout = null;

    var permJson = System.Text.Json.JsonSerializer.Serialize(
        (Model.Permissions ?? new List<RMIS.Models.Account.Roles.ReadPermission>())
        .Select(p => new {
            name   = p.PermissionName,
            read   = p.Read,
            create = p.Create,
            update = p.Update,
            delete = p.Delete,
            export = p.Export
        })
    );
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/account/rolePermission.css" />
</head>
<body>
<div class="rp-page">

    <div class="rp-header">
        <div class="rp-title">
            <span class="rp-role-name">@Model.RoleName</span>
            <span class="rp-label">功能群組權限</span>
        </div>
    </div>

    <div class="rp-content">
        <div id="view-accordion"></div>
    </div>

</div>

<script>
    const permissionsData = @Html.Raw(permJson);
</script>
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/js/account/role/rolePermission.js"></script>
</body>
</html>
