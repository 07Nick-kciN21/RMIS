@model RMIS.Models.Account.Roles.CreateRoleView
@using System.Linq

@{
    Layout = null;

    var permJson = System.Text.Json.JsonSerializer.Serialize(
        (Model.Permissions ?? new List<RMIS.Models.Account.Roles.CreatePermission>())
        .Select(p => new {
            id     = p.PermissionId,
            name   = p.PermissionName,
            read   = p.Read,
            create = p.Create,
            update = p.Update,
            delete = p.Delete,
            export = p.Export
        })
    );
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/account/rolePermission.css" />
</head>
<body>
<div class="rp-page">

    <div class="rp-header">
        <div class="rp-title">
            <span class="rp-role-name">新增功能群組</span>
            <span class="rp-label">建立</span>
        </div>
    </div>

    <div class="rp-form">
        <div class="rp-form-field">
            <label>群組名稱</label>
            <input type="text" id="RoleName" class="form-control" placeholder="請輸入名稱" />
        </div>
        <div class="rp-form-field">
            <label>狀態</label>
            <div class="rp-radio-group">
                <label>
                    <input type="radio" name="Status" value="true" checked /> 啟用
                </label>
                <label>
                    <input type="radio" name="Status" value="false" /> 禁止
                </label>
            </div>
        </div>
    </div>

    <div class="rp-content">
        <div id="view-accordion"></div>
    </div>

    <div class="rp-footer">
        <button id="btn-submit" class="btn btn-primary btn-sm">建立</button>
        <button id="btn-cancel" class="btn btn-secondary btn-sm">取消</button>
    </div>

</div>

<script>
    const permissionsData = @Html.Raw(permJson);
</script>
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/js/account/role/createRole.js"></script>
</body>
</html>
