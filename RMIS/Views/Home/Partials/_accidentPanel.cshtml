@* 交通事故 *@
<link rel="stylesheet" href="~/css/index/accidentPanel.css" />
<div id="accidentPanel" class="panel hide">
    <div class="panelHeading">
        <span>
            交通事故
        </span>
        <button class="closeButton">&times;</button>
    </div>
    <div style="scrollbar-width: thin; height: 90%; overflow-y: auto;">
        <ul class="panelInput panelRadio" style="list-style: none; display: flex;" role="group" aria-label="Basic radio toggle button group">
            <li style="width: 25%">
                <input type="radio" class="btn-check" name="accradio" id="accident1" autocomplete="off"/>
                <label class="btn select" for="accident1">圖層開關</label>
            </li>
            <li style="width: 25%">
                <input type="radio" class="btn-check" name="accradio" id="accident2" autocomplete="off"/>
                <label class="btn" for="accident2">簡易查詢</label>
            </li>

            @if (Model["交通事故"].Export){
                <li style="width: 25%">
                    <input type="radio" class="btn-check" name="accradio" id="accident3" autocomplete="off"/>
                    <label class="btn" for="accident3">資料匯出</label>
                </li>
            }
        </ul>
        <div id="acc1" class="panelBody" style="display: block">
            <div class="form-group">
                <label class="sw-label">
                    <input type="checkbox" name="" id="accCluster" class="sw-chk">
                    <span class="sw-box">
                        <span class="sw-btn"></span>
                    </span>
                    <span>叢集模組</span>
                </label>
            </div>
            <div class="form-group">
                <label class="sw-label">
                    <input type="checkbox" name="" id="accTimeline" class="sw-chk">
                    <span class="sw-box">
                        <span class="sw-btn"></span>
                    </span>
                    <span>A1A2熱區時間軸</span>
                </label>
            </div>
            <div class="form-group">
                <label class="sw-label">
                    <input type="checkbox" name="" id="accTowCmp" class="sw-chk">
                    <span class="sw-box">
                        <span class="sw-btn"></span>
                    </span>
                    <span>前後期比對</span>
                </label>
            </div>
        </div>
        <div id="acc2" class="panelBody" style="display: none">
            <div class="form-group acc-date-row">
                <label>日期範圍</label>
                <div class="acc-date-selects">
                    <select id="accStartYear" class="form-select">
                        <option value="101">101</option>
                        <option value="102">102</option>
                        <option value="103">103</option>
                        <option value="104">104</option>
                        <option value="105">105</option>
                        <option value="106">106</option>
                        <option value="107">107</option>
                        <option value="108">108</option>
                        <option value="109">109</option>
                        <option value="110">110</option>
                        <option value="111">111</option>
                        <option value="112">112</option>
                        <option value="113" selected>113</option>
                    </select>
                    <span>/</span>
                    <select id="accStartMonth" class="form-select">
                        <option value="1" selected>01</option>
                        <option value="2">02</option>
                        <option value="3">03</option>
                        <option value="4">04</option>
                        <option value="5">05</option>
                        <option value="6">06</option>
                        <option value="7">07</option>
                        <option value="8">08</option>
                        <option value="9">09</option>
                        <option value="10">10</option>
                        <option value="11">11</option>
                        <option value="12">12</option>
                    </select>
                    <span>~</span>
                    <select id="accEndYear" class="form-select">
                        <option value="101">101</option>
                        <option value="102">102</option>
                        <option value="103">103</option>
                        <option value="104">104</option>
                        <option value="105">105</option>
                        <option value="106">106</option>
                        <option value="107">107</option>
                        <option value="108">108</option>
                        <option value="109">109</option>
                        <option value="110">110</option>
                        <option value="111">111</option>
                        <option value="112">112</option>
                        <option value="113" selected>113</option>
                    </select>
                    <span>/</span>
                    <select id="accEndMonth" class="form-select">
                        <option value="1">01</option>
                        <option value="2">02</option>
                        <option value="3">03</option>
                        <option value="4">04</option>
                        <option value="5">05</option>
                        <option value="6">06</option>
                        <option value="7">07</option>
                        <option value="8">08</option>
                        <option value="9">09</option>
                        <option value="10">10</option>
                        <option value="11">11</option>
                        <option value="12" selected>12</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label>行政區</label>
                <select id="acc2AdminDict" class="form-select" style="flex-grow: 1;border-radius:0;">
                    <option value="">請選擇</option>
                    <option value="桃園區">桃園區</option>
                    <option value="大溪區">大溪區</option>
                    <option value="中壢區">中壢區</option>
                    <option value="楊梅區">楊梅區</option>
                    <option value="蘆竹區">蘆竹區</option>
                    <option value="大園區">大園區</option>
                    <option value="龜山區">龜山區</option>
                    <option value="八德區">八德區</option>
                    <option value="龍潭區">龍潭區</option>
                    <option value="平鎮區">平鎮區</option>
                    <option value="新屋區">新屋區</option>
                    <option value="觀音區">觀音區</option>
                    <option value="復興區">復興區</option>
                </select>
            </div>
            <div class="form-group">
                <label>事故類型</label>
                <select id="accType" class="form-select" style="flex-grow: 1;border-radius:0;">
                    <option value="" selected>全部</option>
                    <option value="A1">A1</option>
                    <option value="A2">A2</option>
                </select>
            </div>
            <div class="form-group">
                <label>事故地點</label>
                <input type="text" id="accRoad" class="form-control" placeholder="選填" style="flex-grow: 1;border-radius:0;">
            </div>
            <div class="form-group" style="clear: both; padding: 8px; width: 100%; margin: 0 auto; text-align: center; justify-content: center;">
                <button id="acc2GoResult" class="btn js-modal-toggle goResult">進行篩選</button>
            </div>
            <div id="accidentResultCount" style="padding: 0 10px; font-size: 14px; color: #666; display: none;">
                <span>查詢結果：<strong id="accTotalCount">0</strong> 筆</span>
            </div>
            <div id="accidentResultDiv" class="panelList" style="display: none;">
                <table id="accidentTable" class="propTable">
                    <thead id="accidentThead">
                        <th>操作</th>
                        <th>事故類型</th>
                        <th>事故日期</th>
                        <th>時間</th>
                        <th>行政區</th>
                        <th>事故地點</th>
                        <th>交叉路口</th>
                        <th>其他地點</th>
                    </thead>
                    <tbody id="accidentTbody">
                    </tbody>
                </table>
            </div>
            <div id="accidentPagination" style="text-align: center; padding: 5px;"></div>
        </div>
        @if (Model["交通事故"].Export){
            <div id="acc3" class="panelBody" style="display: none">
                <div class="form-group">
                    <label>行政區</label>
                    <select id="acc3AdminDict" class="form-select" style="flex-grow: 1;border-radius:0;">
                        <option value="-1">請選擇</option>
                        <option value="0">桃園區</option>
                        <option value="1">大溪區</option>
                        <option value="2">中壢區</option>
                        <option value="3">楊梅區</option>
                        <option value="4">蘆竹區</option>
                        <option value="5">大園區</option>
                        <option value="6">龜山區</option>
                        <option value="7">八德區</option>
                        <option value="8">龍潭區</option>
                        <option value="9">平鎮區</option>
                        <option value="10">新屋區</option>
                        <option value="11">觀音區</option>
                        <option value="12">復興區</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>年分</label>
                    <select id="acc3Year" class="form-select">
                            @for (int y = 101; y <= 113; y++) {
                                <option value="@y">@y</option>
                            }
                    </select>
                </div>
                <div class="form-group" style="clear: both; padding: 8px; width: 100%; margin: 0 auto; text-align: center; justify-content: center;">
                    <button id="acc3GoResult" class="btn js-modal-toggle goResult">匯出</button>
                </div>
            </div>
        }
    </div>
</div>
