                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-6">
                            <label for="s3-execution-unit">執行單位</label>
                            <input type="text" id="s3-execution-unit" name="execution_unit" class="form-control"
                                   placeholder="請輸入執行單位">
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h4 class="section-title">工程資訊</h4>

                    <div class="form-row">
                        <div class="form-group col-12">
                            <label for="s3-budget">預算(年度)來源核定經費</label>
                            <input type="text" id="s3-budget" name="budget_fiscal_year_approved_amount" class="form-control"
                                placeholder="例：113年度市預算 / 5,000萬元">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-6">
                            <label for="s3-contract-type">開口合約/專業發包</label>
                            <select id="s3-contract-type" name="contract_type" class="form-control">
                                <option value="">請選擇</option>
                                <option value="開口合約">開口合約</option>
                                <option value="專業發包">專業發包</option>
                            </select>
                        </div>
                        <div class="form-group col-6">
                            <label for="s3-period">工期</label>
                            <input type="text" id="s3-period" name="construction_period" class="form-control"
                                placeholder="例：180日曆天">
                        </div>
                    </div>

                    @* ===== 上網公告預計/實際開工 ===== *@
                    <div class="form-row">
                        <div class="form-group col-6">
                            <label>上網公告預計/實際開工</label>
                            <div class="input-group">
                                <select id="s3-announcement-type" name="announcement_commencement_type" class="form-control" style="max-width: 80px;">
                                    <option value="實際">實際</option>
                                    <option value="預計">預計</option>
                                </select>
                                <input type="date" id="s3-announcement-date" name="announcement_commencement_date_value" class="form-control">
                            </div>
                        </div>

                        @* ===== 決標日期預計/實際完工 ===== *@
                        <div class="form-group col-6">
                            <label>決標日期預計/實際完工</label>
                            <div class="input-group">
                                <select id="s3-award-type" name="award_completion_type" class="form-control" style="max-width: 80px;">
                                    <option value="實際">實際</option>
                                    <option value="預計">預計</option>
                                </select>
                                <input type="date" id="s3-award-date" name="award_completion_date_value" class="form-control">
                            </div>
                        </div>
                    </div>


