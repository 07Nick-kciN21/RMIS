@* ==========================================================================
   _processAddModal.cshtml - 歷程紀錄新增表單 Modal
   包含三個階段的不同表單
   ========================================================================== *@

<link rel="stylesheet" href="~/css/index/processAddModal.css" />

@* ===== 新增紀錄 Modal ===== *@
<div id="process-add-modal" class="process-modal hidden">
    <div class="process-modal-backdrop"></div>
    <div class="process-modal-container">
        
        @* Modal Header *@
        <div class="process-modal-header">
            <h3 class="modal-title">
                <i class="fa fa-plus-circle"></i>
                <span id="modal-stage-title">新增歷程紀錄</span>
            </h3>
            <button type="button" class="btn-modal-close" id="btn-close-add-modal">
                <i class="fa fa-times"></i>
            </button>
        </div>

        @* Modal Body - 表單區域 *@
        <div class="process-modal-body">
            @* ===== 階段1表單: 爭取預算與前期規畫階段 ===== *@
            <form id="form-stage1" class="process-form hidden" data-stage="stage1">
                <div class="form-section">
                    <h4 class="section-title">基本資訊</h4>
                    
                    <div class="form-row">
                        <div class="form-group col-6">
                            <label for="s1-district">行政區 <span class="required">*</span></label>
                            <select id="s1-district" name="district" class="form-control" required>
                                <option value="">請選擇</option>
                                <option value="桃園區">桃園區</option>
                                <option value="中壢區">中壢區</option>
                                <option value="大溪區">大溪區</option>
                                <option value="楊梅區">楊梅區</option>
                                <option value="蘆竹區">蘆竹區</option>
                                <option value="大園區">大園區</option>
                                <option value="龜山區">龜山區</option>
                                <option value="八德區">八德區</option>
                                <option value="龍潭區">龍潭區</option>
                                <option value="平鎮區">平鎮區</option>
                                <option value="新屋區">新屋區</option>
                                <option value="觀音區">觀音區</option>
                                <option value="復興區">復興區</option>
                            </select>
                        </div>
                        <div class="form-group col-6">
                            <label for="s1-record-type">記錄類別 <span class="required">*</span></label>
                            <select id="s1-record-type" name="record_type" class="form-control" required>
                                <option value="">請選擇</option>
                                <option value="重要里程碑">重要里程碑</option>
                                <option value="會議紀錄">會議紀錄</option>
                                <option value="公文核定">公文核定</option>
                                <option value="進度說明">進度說明</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-12">
                            <label for="s1-record-title">記錄標題 <span class="required">*</span></label>
                            <input type="text" id="s1-record-title" name="record_title" class="form-control" 
                                   placeholder="請輸入記錄標題" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-12">
                            <label for="s1-project-name">工程名稱 <span class="required">*</span></label>
                            <input type="text" id="s1-project-name" name="project_name" class="form-control"
                                   placeholder="請輸入工程名稱" readonly>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-6">
                            <label for="s1-execution-unit">執行單位</label>
                            <input type="text" id="s1-execution-unit" name="execution_unit" class="form-control"
                                   placeholder="請輸入執行單位">
                        </div>
                        <div class="form-group col-6">
                            <label for="s1-construction-unit">工程單位</label>
                            <input type="text" id="s1-construction-unit" name="construction_unit" class="form-control"
                                   placeholder="請輸入工程單位">
                        </div>
                    </div>                    
                </div>

                <div class="form-section">
                    <h4 class="section-title">會議資訊</h4>
                    
                    <div class="form-row">
                        <div class="form-group col-12">
                            <label for="s1-previous-status">前次會議辦理情形</label>
                            <textarea id="s1-previous-status" name="previous_meeting_status" class="form-control" 
                                      rows="3" placeholder="請輸入前次會議辦理情形"></textarea>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-12">
                            <label for="s1-previous-resolution">前次會議裁示</label>
                            <textarea id="s1-previous-resolution" name="previous_meeting_resolution" class="form-control" 
                                      rows="3" placeholder="請輸入前次會議裁示"></textarea>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-12">
                            <label for="s1-current-status">最新辦理情形 <span class="required">*</span></label>
                            <textarea id="s1-current-status" name="current_status" class="form-control" 
                                      rows="4" placeholder="請輸入最新辦理情形" required></textarea>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-12">
                            <label for="s1-current-resolution">本次會議裁示</label>
                            <textarea id="s1-current-resolution" name="current_meeting_resolution" class="form-control" 
                                      rows="3" placeholder="請輸入本次會議裁示"></textarea>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h4 class="section-title">附件上傳</h4>
                    <div class="form-row">
                        <div class="form-group col-12">
                            <label for="s1-files">佐證文件</label>
                            <div class="file-upload-area" id="s1-file-upload">
                                <input type="file" id="s1-files" name="files" multiple class="file-input">
                                <div class="file-upload-hint">
                                    <i class="fa fa-cloud-upload"></i>
                                    <p>點擊或拖曳檔案至此處上傳</p>
                                    <span>支援 PDF、DOC、DOCX、XLS、XLSX、PPT、PPTX、JPG、PNG、ZIP</span>
                                </div>
                            </div>
                            <div class="file-list" id="s1-file-list"></div>
                        </div>
                    </div>
                </div>
            </form>

            @* ===== 階段2表單: 意願調查及用地取得階段 ===== *@
            <form id="form-stage2" class="process-form hidden" data-stage="stage2">
                <div class="form-section">
                    <h4 class="section-title">基本資訊</h4>
                    
                    <div class="form-row">
                        <div class="form-group col-4">
                            <label for="s2-district">行政區 <span class="required">*</span></label>
                            <select id="s2-district" name="district" class="form-control" required>
                                <option value="">請選擇</option>
                                <option value="桃園區">桃園區</option>
                                <option value="中壢區">中壢區</option>
                                <option value="大溪區">大溪區</option>
                                <option value="楊梅區">楊梅區</option>
                                <option value="蘆竹區">蘆竹區</option>
                                <option value="大園區">大園區</option>
                                <option value="龜山區">龜山區</option>
                                <option value="八德區">八德區</option>
                                <option value="龍潭區">龍潭區</option>
                                <option value="平鎮區">平鎮區</option>
                                <option value="新屋區">新屋區</option>
                                <option value="觀音區">觀音區</option>
                                <option value="復興區">復興區</option>
                            </select>
                        </div>
                        <div class="form-group col-4">
                            <label for="s2-record-type">記錄類別 <span class="required">*</span></label>
                            <select id="s2-record-type" name="record_type" class="form-control" required>
                                <option value="">請選擇</option>
                                <option value="重要里程碑">重要里程碑</option>
                                <option value="會議紀錄">會議紀錄</option>
                                <option value="公文核定">公文核定</option>
                                <option value="進度說明">進度說明</option>
                            </select>
                        </div>
                        <div class="form-group col-4">
                            <label for="s2-category">類別</label>
                            <select id="s2-category" name="category" class="form-control">
                                <option value="">請選擇</option>
                                <option value="意願調查">意願調查</option>
                                <option value="協議價購">協議價購</option>
                                <option value="徵收作業">徵收作業</option>
                                <option value="補償發放">補償發放</option>
                                <option value="其他">其他</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-12">
                            <label for="s2-record-title">記錄標題 <span class="required">*</span></label>
                            <input type="text" id="s2-record-title" name="record_title" class="form-control" 
                                   placeholder="請輸入記錄標題" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-12">
                            <label for="s2-project-name">工程名稱 <span class="required">*</span></label>
                            <input type="text" id="s2-project-name" name="project_name" class="form-control"
                                   placeholder="請輸入工程名稱" readonly>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-6">
                            <label for="s2-execution-unit">執行單位</label>
                            <input type="text" id="s2-execution-unit" name="execution_unit" class="form-control"
                                   placeholder="請輸入執行單位">
                        </div>
                        <div class="form-group col-6">
                            <label for="s2-construction-unit">工程單位</label>
                            <input type="text" id="s2-construction-unit" name="construction_unit" class="form-control"
                                   placeholder="請輸入工程單位">
                        </div>
                    </div>                    
                </div>

                <div class="form-section">
                    <h4 class="section-title">會議資訊</h4>
                    
                    <div class="form-row">
                        <div class="form-group col-12">
                            <label for="s2-previous-status">前次會議辦理情形</label>
                            <textarea id="s2-previous-status" name="previous_meeting_status" class="form-control" 
                                      rows="3" placeholder="請輸入前次會議辦理情形"></textarea>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-12">
                            <label for="s2-previous-resolution">前次會議裁示</label>
                            <textarea id="s2-previous-resolution" name="previous_meeting_resolution" class="form-control" 
                                      rows="3" placeholder="請輸入前次會議裁示"></textarea>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-12">
                            <label for="s2-current-status">最新辦理情形 <span class="required">*</span></label>
                            <textarea id="s2-current-status" name="current_status" class="form-control" 
                                      rows="4" placeholder="請輸入最新辦理情形" required></textarea>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-12">
                            <label for="s2-current-resolution">本次會議裁示</label>
                            <textarea id="s2-current-resolution" name="current_meeting_resolution" class="form-control" 
                                      rows="3" placeholder="請輸入本次會議裁示"></textarea>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h4 class="section-title">附件上傳</h4>
                    <div class="form-row">
                        <div class="form-group col-12">
                            <label for="s2-files">佐證文件</label>
                            <div class="file-upload-area" id="s2-file-upload">
                                <input type="file" id="s2-files" name="files" multiple class="file-input">
                                <div class="file-upload-hint">
                                    <i class="fa fa-cloud-upload"></i>
                                    <p>點擊或拖曳檔案至此處上傳</p>
                                    <span>支援 PDF、DOC、DOCX、XLS、XLSX、PPT、PPTX、JPG、PNG、ZIP</span>
                                </div>
                            </div>
                            <div class="file-list" id="s2-file-list"></div>
                        </div>
                    </div>
                </div>
            </form>

            @* ===== 階段3表單: 設計與施工階段 ===== *@
            <form id="form-stage3" class="process-form hidden" data-stage="stage3">
                <div class="form-section">
                    <h4 class="section-title">基本資訊</h4>
                    
                    <div class="form-row">
                        <div class="form-group col-6">
                            <label for="s3-district">行政區 <span class="required">*</span></label>
                            <select id="s3-district" name="district" class="form-control" required>
