        @* Modal Footer *@
        <div class="process-modal-footer">
            <button type="button" class="btn btn-outline-secondary" id="btn-cancel-add">
                <i class="fa fa-times"></i> 取消
            </button>
            <button type="button" class="btn btn-primary" id="btn-submit-add">
                <i class="fa fa-check"></i> 儲存
            </button>
        </div>

    </div>
</div>
